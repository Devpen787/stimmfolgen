{
  "name":"stimmfolgen-demo",
  "main":"worker.mjs",
  "compatibility_date":"2026-10-15",
  "workers_dev":true,
  "assets":{"directory":".local/assets","binding":"ASSETS","run_worker_first":["/api/*"]},
  "durable_objects":{"bindings":[{"name":"DEMO_GATE","class_name":"DemoGate"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["DemoGate"]}],
  "vars":{"LIVE_ENABLED":"false"},
  "observability":{"enabled":false}
}
